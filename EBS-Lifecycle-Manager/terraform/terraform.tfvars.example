aws_region   = "us-east-1"
project_name = "ebs-lifecycle-manager"
environment  = "production"

tags = {
  Owner = "shakeelsaga" # Replace with your own name/handle before deploying
}

# Daily at 03:00 UTC. See AWS EventBridge schedule expression docs for syntax.
schedule_expression = "cron(0 3 * * ? *)"

lambda_timeout      = 300
lambda_memory_size  = 256
log_retention_days  = 14

# Leave blank to run without Slack notifications.
slack_webhook_url = ""
